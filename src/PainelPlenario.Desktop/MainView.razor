@implements IDisposable
@inject PlenarioStateService Estado
@inject IServiceProvider Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using PainelPlenario.Data
@inject IDbContextFactory<PlenarioDbContext> DbFactory

<div class="console-layout">
    
    <!-- ======================================================== -->
    <!-- BARRA LATERAL VERTICAL (ESQUERDA)                        -->
    <!-- ======================================================== -->
    <aside class="sidebar">
        <div>
            <!-- IDENTIFICAÇÃO DA CÂMARA NA SIDEBAR -->
            <div class="sidebar-brand">
                <div style="font-size: 0.72rem; color: #15B79E; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    Console do Operador
                </div>
                <div style="font-size: 1rem; font-weight: 700; color: #FAFAFA; margin-top: 4px;">
                    @Estado.Configuracao.NomeCamara
                </div>
            </div>

            <!-- BOTÃO DE DESTAQUE PARA ABRIR O TELÃO -->
            <button class="btn btn-verde" @onclick="AbrirJanelaTelao" style="width: 100%; padding: 11px; margin-bottom: 10px;">
                <Blazicon Svg="Lucide.Tv" />
                <span>Abrir Telão</span>
            </button>
        </div>

        <!-- NAVEGAÇÃO PRINCIPAL -->
        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Sessão Plenária</div>

            <button class="sidebar-item @(Estado.ModoAtual == ModoTelao.QuorumPresenca && modoOperador == "painel" ? "ativo" : "")"
                    @onclick='() => SelecionarAba("painel", ModoTelao.QuorumPresenca)'>
                <span class="sidebar-item-left">
                    <Blazicon Svg="Lucide.Users" />
                    <span>Quórum</span>
                </span>
            </button>

            <button class="sidebar-item @(modoOperador == "pauta" ? "ativo" : "")"
                    @onclick='() => SelecionarAba("pauta")'>
                <span class="sidebar-item-left">
                    <Blazicon Svg="Lucide.ClipboardList" />
                    <span>Pauta</span>
                </span>
                <span class="sidebar-badge">@(Estado.SessaoAtiva?.ItensPauta.Count ?? 0)</span>
            </button>

            <button class="sidebar-item @(Estado.ModoAtual == ModoTelao.TribunaCronometro && modoOperador == "painel" ? "ativo" : "")"
                    @onclick='() => SelecionarAba("painel", ModoTelao.TribunaCronometro)'>
                <span class="sidebar-item-left">
                    <Blazicon Svg="Lucide.Mic" />
                    <span>Tribuna</span>
                </span>
            </button>

            <button class="sidebar-item @((Estado.ModoAtual == ModoTelao.VotacaoNominal || Estado.ModoAtual == ModoTelao.ResultadoProclamado) && modoOperador == "painel" ? "ativo" : "")"
                    @onclick='() => SelecionarAba("painel", ModoTelao.VotacaoNominal)'>
                <span class="sidebar-item-left">
                    <Blazicon Svg="Lucide.Vote" />
                    <span>Votação</span>
                </span>
            </button>

            <div class="sidebar-section-label" style="margin-top: 12px;">Administração</div>

            <button class="sidebar-item @(modoOperador == "configuracoes" ? "ativo" : "")"
                    @onclick='() => SelecionarAba("configuracoes")'>
                <span class="sidebar-item-left">
                    <Blazicon Svg="Lucide.Settings" />
                    <span>Configurações</span>
                </span>
            </button>
        </nav>

        <!-- RODAPÉ DA SIDEBAR -->
        <div class="sidebar-footer">
            <button class="sidebar-item pdf" @onclick="() => confirmarExportacaoPdf = true">
                <span class="sidebar-item-left">
                    <Blazicon Svg="Lucide.FileDown" />
                    <span>Extrato PDF</span>
                </span>
            </button>
        </div>
    </aside>

    <!-- ======================================================== -->
    <!-- ÁREA DE CONTEÚDO (DIREITA)                               -->
    <!-- ======================================================== -->
    <main class="main-content">
        <div style="max-width: 1400px; margin: 0 auto;">

            <!-- CABEÇALHO LIMPO (SEM BOTÕES DE NAVEGAÇÃO) -->
            <header style="display: flex; justify-content: space-between; align-items: center; background: #171717; padding: 16px 24px; border-radius: 12px; margin-bottom: 24px; border: 1px solid #292929;">
                <div>
                    <h1 style="font-size: 1.5rem; color: #15B79E; margin-bottom: 4px;">
                        @(Estado.SessaoAtiva?.TituloFormatado ?? "Câmara Municipal")
                    </h1>
                    <p style="color: #94a3b8; font-size: 0.9rem;">
                        @Estado.Configuracao.Cidade - @Estado.Configuracao.Estado <Blazicon Svg="Lucide.MoveRight"/> @Estado.Configuracao.Legislatura
                    </p>
                </div>

                <div style="display: flex; gap: 16px; align-items: center;">
                    <div style="text-align: center;">
                        <span style="display: block; font-size: 0.72rem; color: #94a3b8; text-transform: uppercase;">Status da Sessão</span>
                        <strong style="color: #17B26A; font-size: 0.95rem;">EM ANDAMENTO</strong>
                    </div>
                    <div style="background: #0F0F0F; border: 1px solid #292929; padding: 8px 16px; border-radius: 8px; text-align: center;">
                        <span style="display: block; font-size: 0.72rem; color: #94a3b8; text-transform: uppercase;">Quórum Presente</span>
                        <strong style="color: #FAFAFA; font-size: 1.1rem;">@Estado.TotalPresentes / @Estado.Configuracao.TotalCadeiras</strong>
                    </div>
                </div>
            </header>

            <!-- ÁREA PRINCIPAL CONFORME O MODO ATUAL -->
            @if (modoOperador == "configuracoes")
            {
                <div style="background: #171717; border-radius: 12px; padding: 24px; border: 1px solid #292929; margin-bottom: 24px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #292929; padding-bottom: 16px;">
                        <h2 style="color: #15B79E; font-size: 1.4rem; font-weight: 700; display: flex; align-items: center; gap: 10px;">
                            <Blazicon Svg="Lucide.Settings" /> Configurações
                        </h2>

                        <!-- SUB-ABAS DE CONFIGURAÇÃO -->
                        <div style="display: flex; gap: 8px;">
                            <button class="btn @(subAbaConfig == "identidade" ? "btn-ativo" : "")" @onclick='() => subAbaConfig = "identidade"'>
                                <Blazicon Svg="Lucide.Landmark" /> Identidade da Câmara
                            </button>
                            <button class="btn @(subAbaConfig == "vereadores" ? "btn-ativo" : "")" @onclick='() => subAbaConfig = "vereadores"'>
                                <Blazicon Svg="Lucide.Users" /> Vereadores (@Estado.Parlamentares.Count)
                            </button>
                            <button class="btn @(subAbaConfig == "regras" ? "btn-ativo" : "")" @onclick='() => subAbaConfig = "regras"'>
                                <Blazicon Svg="Lucide.Timer" /> Cronômetro & Regras
                            </button>
                        </div>
                    </div>

                    @if (mensagemSalvo != null)
                    {
                        <div style="background: #065f46; color: #a7f3d0; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-weight: 600;">
                            @mensagemSalvo
                        </div>
                    }

                    @if (subAbaConfig == "identidade")
                    {
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div>
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Nome Oficial da Câmara</label>
                                <input @bind="configEdicao.NomeCamara" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" placeholder="Ex: Câmara Municipal de Caruaru" />
                            </div>

                            <div>
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Slogan Institucional</label>
                                <input @bind="configEdicao.Slogan" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" placeholder="Ex: A Casa do Povo em defesa da cidadania" />
                            </div>

                            <div>
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Município (Cidade)</label>
                                <input @bind="configEdicao.Cidade" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" placeholder="Ex: Caruaru" />
                            </div>

                            <div>
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">UF (Estado)</label>
                                <input @bind="configEdicao.Estado" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" placeholder="Ex: PE" />
                            </div>

                            <div style="grid-column: span 2;">
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Identificação da Legislatura</label>
                                <input @bind="configEdicao.Legislatura" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" placeholder="Ex: 19ª Legislatura (2025-2028)" />
                            </div>
                        </div>

                        <div style="margin-top: 24px; text-align: right;">
                            <button class="btn btn-verde" @onclick="SalvarIdentidadeAsync" style="padding: 10px 24px; font-size: 1rem;">
                                <Blazicon Svg="Lucide.Save" /> Salvar
                            </button>
                        </div>
                    }
                    else if (subAbaConfig == "vereadores")
                    {
                        <!-- FORMULÁRIO DE NOVO / EDITAR VEREADOR -->
                        <div style="background: #0F0F0F; padding: 20px; border-radius: 8px; border: 1px solid #292929; margin-bottom: 24px;">
                            <h3 style="color: #15B79E; font-size: 1.1rem; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                                @if (vereadorEmEdicao.Id == Guid.Empty)
                                {
                                    <Blazicon Svg="Lucide.UserPlus" />
                                    <span>Cadastrar Novo Parlamentar</span>
                                }
                                else
                                {
                                    <Blazicon Svg="Lucide.Pencil" />
                                    <span>Editando Parlamentar</span>
                                }
                            </h3>

                            <!-- FOTO DO PARLAMENTAR -->
                            <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid #292929;">
                                @{
                                    var fotoPreview = FotoHelper.ObterDataUrl(vereadorEmEdicao.FotoCaminho);
                                }
                                <div style="width: 68px; height: 68px; border-radius: 50%; background: #171717; border: 2px solid #292929; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    @if (!string.IsNullOrEmpty(fotoPreview))
                                    {
                                        <img src="@fotoPreview" alt="Foto" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <Blazicon Svg="Lucide.User" style="width: 30px; height: 30px; color: #898989;" />
                                    }
                                </div>

                                <div style="display: flex; flex-direction: column; gap: 6px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <label class="btn" style="cursor: pointer;">
                                            <Blazicon Svg="Lucide.Camera" />
                                            <span>@(string.IsNullOrEmpty(vereadorEmEdicao.FotoCaminho) ? "Selecionar Foto" : "Trocar Foto")</span>
                                            <InputFile OnChange="AoSelecionarFotoVereadorAsync" accept=".jpg,.jpeg,.png,.webp" style="display: none;" />
                                        </label>

                                        @if (!string.IsNullOrEmpty(vereadorEmEdicao.FotoCaminho))
                                        {
                                            <button type="button" class="btn" @onclick="RemoverFotoEmEdicao" style="color: #fca5a5;">
                                                <Blazicon Svg="Lucide.X" />
                                                <span>Remover</span>
                                            </button>
                                        }
                                    </div>
                                    <span style="font-size: 0.78rem; color: #898989;">
                                        JPG, PNG ou WEBP (redimensionada automaticamente)
                                    </span>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 2fr 1.5fr 1fr 1.5fr auto auto; gap: 12px; align-items: end;">
                                <div>
                                    <label style="display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 4px;">Nome Completo</label>
                                    <input @bind="vereadorEmEdicao.NomeCompleto" style="width: 100%; padding: 8px; border-radius: 6px; background: #171717; color: white; border: 1px solid #292929;" placeholder="Nome Civil" />
                                </div>

                                <div>
                                    <label style="display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 4px;">Nome Político (Painel/Urna)</label>
                                    <input @bind="vereadorEmEdicao.NomePolitico" style="width: 100%; padding: 8px; border-radius: 6px; background: #171717; color: white; border: 1px solid #292929;" placeholder="Ex: Ver. Zé da Farmácia" />
                                </div>

                                <div>
                                    <label style="display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 4px;">Partido</label>
                                    <input @bind="vereadorEmEdicao.Partido" style="width: 100%; padding: 8px; border-radius: 6px; background: #171717; color: white; border: 1px solid #292929;" placeholder="Ex: MDB" />
                                </div>

                                <div>
                                    <label style="display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 4px;">Cargo na Mesa</label>
                                    <select @bind="vereadorEmEdicao.CargoMesa" style="width: 100%; padding: 8px; border-radius: 6px; background: #171717; color: white; border: 1px solid #292929;">
                                        <option value="Vereador">Vereador</option>
                                        <option value="Presidente">Presidente</option>
                                        <option value="Vice-Presidente">Vice-Presidente</option>
                                        <option value="1º Secretário">1º Secretário</option>
                                        <option value="2º Secretário">2º Secretário</option>
                                    </select>
                                </div>

                                <div style="display: flex; align-items: center; gap: 8px; height: 38px;">
                                    <label style="color: #cbd5e1; font-size: 0.9rem; cursor: pointer;">
                                        <input type="checkbox" @bind="vereadorEmEdicao.Ativo" /> Ativo
                                    </label>
                                </div>

                                <div style="display: flex; gap: 8px;">
                                    <button class="btn btn-verde" @onclick="SalvarVereadorAsync" style="height: 38px;">
                                        <Blazicon Svg="Lucide.Save" /> Salvar
                                    </button>
                                    @if (vereadorEmEdicao.Id != Guid.Empty)
                                    {
                                        <button class="btn" @onclick="CancelarEdicaoVereador" style="height: 38px;">
                                            Cancelar
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- LISTAGEM DA BANCADA ATUAL -->
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            @foreach (var v in Estado.Parlamentares)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; background: #0F0F0F; padding: 12px 16px; border-radius: 8px; border: 1px solid #292929;">
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        @{
                                            var fotoLista = FotoHelper.ObterDataUrl(v.FotoCaminho);
                                        }
                                        <div style="width: 40px; height: 40px; border-radius: 50%; background: #171717; border: 1px solid #292929; overflow: hidden; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                            @if (!string.IsNullOrEmpty(fotoLista))
                                            {
                                                <img src="@fotoLista" alt="@v.NomePolitico" style="width: 100%; height: 100%; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <Blazicon Svg="Lucide.User" style="width: 20px; height: 20px; color: #898989;" />
                                            }
                                        </div>


                                        <div>
                                            <strong style="color: #FAFAFA; font-size: 1.05rem;">@v.NomePolitico</strong>
                                            <span style="color: #898989; font-size: 0.9rem; margin-left: 8px;">(@v.NomeCompleto)</span>
                                            <span style="background: #292929; color: #15B79E; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; margin-left: 10px;">
                                                @v.Partido
                                            </span>
                                            <span style="color: #FAFAFA; font-size: 0.85rem; margin-left: 10px;">
                                                Cargo: <strong>@v.CargoMesa</strong>
                                            </span>
                                            @if (!v.Ativo)
                                            {
                                                <span style="background: #7f1d1d; color: #fca5a5; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; margin-left: 8px;">
                                                    LICENCIADO / INATIVO
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div>
                                        <button class="btn" @onclick="() => EditarVereador(v)" style="padding: 6px 12px; font-size: 0.85rem;">
                                            <Blazicon Svg="Lucide.Pencil" /> Editar
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (subAbaConfig == "regras")
                    {
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div>
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Tempo de Pequeno Expediente (minutos)</label>
                                <input type="number" @bind="configEdicao.TempoPequenoExpedienteMinutos" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" />
                            </div>

                            <div>
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Tempo de Grande Expediente / Tribuna (minutos)</label>
                                <input type="number" @bind="configEdicao.TempoGrandeExpedienteMinutos" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" />
                            </div>

                            <div>
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Tempo de Aparte Regimental (minutos)</label>
                                <input type="number" @bind="configEdicao.TempoAparteMinutos" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" />
                            </div>

                            <div>
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Tempo de Questão de Ordem (minutos)</label>
                                <input type="number" @bind="configEdicao.TempoQuestaoOrdemMinutos" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" />
                            </div>

                            <div>
                                <label style="display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px;">Total de Cadeiras da Câmara (Fixadas por Lei)</label>
                                <input type="number" @bind="configEdicao.TotalCadeiras" style="width: 100%; padding: 10px; border-radius: 6px; background: #0F0F0F; color: white; border: 1px solid #292929;" />
                            </div>
                        </div>

                        <div style="margin-top: 24px; text-align: right;">
                            <button class="btn btn-verde" @onclick="SalvarRegrasAsync" style="padding: 10px 24px; font-size: 1rem;">
                                <Blazicon Svg="Lucide.Save" /> Salvar
                            </button>
                        </div>
                    }
                </div>
            }
            else if (modoOperador == "pauta")
            {
                <!-- ABA DE GESTÃO DA PAUTA -->
                <div style="background: #171717; border-radius: 12px; padding: 24px; border: 1px solid #292929; margin-bottom: 24px;">
                    <h2 style="color: #15B79E; font-size: 1.4rem; margin-bottom: 16px; display: flex; align-items: center; gap: 10px;">
                        <Blazicon Svg="Lucide.ClipboardList" /> Pauta de Matérias
                    </h2>

                    <!-- FORMULÁRIO RÁPIDO PARA ADICIONAR MATÉRIA -->
                    <div style="display: grid; grid-template-columns: 200px 150px 250px 1fr auto; gap: 12px; background: #0F0F0F; padding: 16px; border-radius: 8px; margin-bottom: 24px; border: 1px solid #292929; align-items: end;">
                        <div>
                            <label style="display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 4px;">Tipo</label>
                            <input @bind="novoTipo" style="width: 100%; padding: 8px; border-radius: 6px; background: #171717; color: white; border: 1px solid #292929;" placeholder="Ex: Projeto de Lei" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 4px;">Número/Ano</label>
                            <input @bind="novoNumero" style="width: 100%; padding: 8px; border-radius: 6px; background: #171717; color: white; border: 1px solid #292929;" placeholder="Ex: 005/2026" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 4px;">Autor</label>
                            <input @bind="novoAutor" style="width: 100%; padding: 8px; border-radius: 6px; background: #171717; color: white; border: 1px solid #292929;" placeholder="Ex: Ver. Carlos Silva" />
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 4px;">Ementa (Resumo)</label>
                            <input @bind="novaEmenta" style="width: 100%; padding: 8px; border-radius: 6px; background: #171717; color: white; border: 1px solid #292929;" placeholder="Descrição do projeto..." />
                        </div>
                        <button class="btn btn-verde" @onclick="AdicionarNovaMateria" style="height: 38px;">
                            <Blazicon Svg="Lucide.Plus" /> Inserir
                        </button>
                    </div>

                    <!-- LISTAGEM DAS MATÉRIAS -->
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        @if (Estado.SessaoAtiva != null)
                        {
                            @foreach (var item in Estado.SessaoAtiva.ItensPauta.OrderBy(i => i.Ordem))
                            {
                                var ehAtual = Estado.MateriaAtual?.Id == item.Id;

                                <div style="display: flex; justify-content: space-between; align-items: center; background: @(ehAtual ? "#0A2926" : "#0F0F0F"); padding: 16px 20px; border-radius: 8px; border: 1px solid @(ehAtual ? "#15B79E" : "#292929");">
                                    <div style="flex: 1;">
                                        <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 6px;">
                                            <span style="background: #292929; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: bold;">
                                                #@item.Ordem
                                            </span>
                                            <strong style="color: #15B79E; font-size: 1.1rem;">@item.Tipo @item.Numero</strong>
                                            <span style="color: #94a3b8; font-size: 0.85rem;">por @item.Autor</span>

                                            @if (item.Status == StatusItemPauta.Concluido)
                                            {
                                                <span style="margin-left: 8px; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; background: @(item.Resultado == ResultadoVotacao.Aprovado ? "#065f46" : "#991b1b"); color: white;">
                                                    @item.Resultado?.ToString().ToUpper()
                                                </span>
                                            }
                                        </div>
                                        <p style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.3;">@item.Ementa</p>
                                    </div>

                                    <div style="margin-left: 20px;">
                                        <button class="btn btn-verde" @onclick="() => IniciarVotacao(item)">
                                            @if (ehAtual)
                                            {
                                                <Blazicon Svg="Lucide.CircleDot" />
                                                <span>Em Votação</span>
                                            }
                                            else
                                            {
                                                <Blazicon Svg="Lucide.Play" />
                                                <span>Iniciar Votação</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                @if (Estado.ModoAtual == ModoTelao.TribunaCronometro)
                {
                    <!-- MODO CRONÔMETRO -->
                    <div style="background: #171717; border-radius: 12px; padding: 32px; text-align: center; border: 1px solid #292929; margin-bottom: 24px;">
                        <h2 style="color: #94a3b8; font-size: 1.2rem; text-transform: uppercase;">Tempo de Discurso na Tribuna</h2>

                        <!-- GESTÃO DO ORADOR & APARTE (LINHA ÚNICA COMPACTA) -->
                        <div style="background: #0F0F0F; padding: 14px 18px; border-radius: 10px; border: 1px solid #292929; margin-bottom: 20px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
                                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                                    <span style="font-size: 0.82rem; font-weight: 700; color: #898989; text-transform: uppercase; letter-spacing: 1px;">
                                        Tribuna:
                                    </span>
                                    @if (Estado.OradorAtual != null)
                                    {
                                        var fotoOrador = FotoHelper.ObterDataUrl(Estado.OradorAtual.FotoCaminho);
                                        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(21, 183, 158, 0.15); border: 1px solid #15B79E; padding: 3px 10px; border-radius: 999px;">
                                            <div style="width: 22px; height: 22px; border-radius: 50%; overflow: hidden; background: #171717; display: flex; align-items: center; justify-content: center;">
                                                @if (!string.IsNullOrEmpty(fotoOrador))
                                                {
                                                    <img src="@fotoOrador" style="width: 100%; height: 100%; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <Blazicon Svg="Lucide.User" style="width: 12px; height: 12px; color: #15B79E;" />
                                                }
                                            </div>
                                            <strong style="color: #15B79E; font-size: 0.9rem;">@Estado.OradorAtual.NomePolitico</strong>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: #898989; font-size: 0.88rem; font-style: italic;">
                                            Geral / Convidado
                                        </span>
                                    }

                                    @if (Estado.ApartanteAtual != null)
                                    {
                                        <div style="display: inline-flex; align-items: center; gap: 6px; background: rgba(245, 158, 11, 0.15); border: 1px solid #f59e0b; padding: 3px 10px; border-radius: 999px;">
                                            <span style="font-size: 0.75rem; font-weight: 800; color: #f59e0b; text-transform: uppercase;">Aparte:</span>
                                            <strong style="color: #f59e0b; font-size: 0.9rem;">@Estado.ApartanteAtual.NomePolitico</strong>
                                            <button type="button" @onclick="() => Estado.LimparApartante()" style="background: transparent; border: none; color: #f59e0b; cursor: pointer; padding: 0 0 0 4px; display: flex; align-items: center;">
                                                <Blazicon Svg="Lucide.X" style="width: 12px; height: 12px;" />
                                            </button>
                                        </div>
                                    }
                                </div>

                                @if (Estado.OradorAtual != null)
                                {
                                    <button class="btn btn-vermelho" @onclick="() => Estado.LimparOrador()" style="padding: 4px 10px; font-size: 0.8rem;">
                                        <Blazicon Svg="Lucide.X" />
                                        <span>Tribuna Geral</span>
                                    </button>
                                }
                            </div>

                            <!-- GRADE ÚNICA DE PARLAMENTARES -->
                            <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: left;">
                                <button class="btn @(Estado.OradorAtual == null ? "btn-ativo" : "")"
                                        @onclick="() => Estado.LimparOrador()"
                                        style="padding: 6px 12px; font-size: 0.85rem;">
                                    <Blazicon Svg="Lucide.Users" />
                                    <span>Geral</span>
                                </button>

                                @foreach (var p in Estado.ParlamentaresAtivos)
                                {
                                    var presenca = Estado.SessaoAtiva?.Presencas.FirstOrDefault(pr => pr.ParlamentarId == p.Id);
                                    var presente = presenca?.Presente ?? false;
                                    var ehOrador = Estado.OradorAtual?.Id == p.Id;
                                    var ehApartante = Estado.ApartanteAtual?.Id == p.Id;

                                    @if (presente)
                                    {
                                        <div style="@($"display: inline-flex; align-items: center; background: #292929; border-radius: 8px; overflow: hidden;")">
                                            <!-- CLIQUE NO NOME: DEFINE COMO ORADOR PRINCIPAL -->
                                            <button class="btn @(ehOrador ? "btn-ativo" : "")"
                                                    @onclick="() => Estado.DefinirOrador(p)"
                                                    style="border: none; border-radius: 0; padding: 6px 10px; font-size: 0.85rem; background: @(ehOrador ? "#17B26A" : "transparent");">
                                                <span>@p.NomePolitico</span>
                                            </button>

                                            <!-- ÍCONE DE APARTE: SÓ SURGE SE HOUVER ORADOR NA TRIBUNA E NÃO FOR ELE MESMO -->
                                            @if (Estado.OradorAtual != null && !ehOrador)
                                            {
                                                <button type="button"
                                                        @onclick="() => AlternarApartante(p)"
                                                        title="@(ehApartante ? "Encerrar Aparte" : $"Conceder Aparte a {p.NomePolitico}")"
                                                        style="@($"border: none; border-left: 1px solid #3C3C3C; padding: 6px 8px; cursor: pointer; display: flex; align-items: center; background: {(ehApartante ? "#f59e0b" : "transparent")}; color: {(ehApartante ? "#0F0F0F" : "#f59e0b")};")">
                                                    <Blazicon Svg="Lucide.Mic" style="width: 14px; height: 14px;" />
                                                </button>
                                            }
                                        </div>
                                        
                                    }

                                }
                            </div>
                        </div>

                        <div class="cronometro-tempo @(Estado.TempoRestanteSegundos <= 60 && Estado.TempoRestanteSegundos > 0 ? "cronometro-alerta" : "")">
                            @TimeSpan.FromSeconds(Estado.TempoRestanteSegundos).ToString(@"mm\:ss")
                        </div>

                        <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
                            <button class="btn btn-verde" @onclick="() => Estado.IniciarCronometro(Estado.Configuracao.TempoGrandeExpedienteMinutos * 60)">
                                <Blazicon Svg="Lucide.Play" /> Grande Exp. (@Estado.Configuracao.TempoGrandeExpedienteMinutos min)
                            </button>
                            <button class="btn btn-azul" @onclick="() => Estado.IniciarCronometro(Estado.Configuracao.TempoPequenoExpedienteMinutos * 60)">
                                <Blazicon Svg="Lucide.Play" /> Pequeno Exp. (@Estado.Configuracao.TempoPequenoExpedienteMinutos min)
                            </button>
                            <button class="btn btn-amarelo" @onclick="() => Estado.IniciarCronometro(Estado.Configuracao.TempoAparteMinutos * 60)">
                                <Blazicon Svg="Lucide.Play" /> Aparte (@Estado.Configuracao.TempoAparteMinutos min)
                            </button>
                            <button class="btn" style="background: #292929;" @onclick="() => Estado.IniciarCronometro(Estado.Configuracao.TempoQuestaoOrdemMinutos * 60)">
                                <Blazicon Svg="Lucide.Play" /> Questão de Ordem (@Estado.Configuracao.TempoQuestaoOrdemMinutos min)
                            </button>
                            <button class="btn" @onclick="() => Estado.PausarOuRetomarCronometro()">
                                @if (Estado.CronometroRodando)
                                {
                                    <Blazicon Svg="Lucide.Pause" />
                                    <span>Pausar</span>
                                }
                                else
                                {
                                    <Blazicon Svg="Lucide.Play" />
                                    <span>Retomar</span>
                                }
                            </button>
                            <button class="btn btn-vermelho" @onclick="() => Estado.ZerarCronometro()"><Blazicon Svg="Lucide.Square" /> Zerar</button>
                            <div style="display:flex; justify-content: center; gap: 12px;">
                                <input type=number @bind="minutosAdicionais" style="width: 4vw; padding: 8px; border-radius: 6px; background: #171717; color: white; border: 1px solid #292929;" placeholder="5 (min)" />
                                <button class="btn btn-verde"
                                        @onclick="() => AdicionarTempoPersonalizado()"><Blazicon Svg="Lucide.Plus" /></button>
                            </div>
                            <div style="display:flex; justify-content: center; gap: 12px;">
                                <button class="btn btn-vazado mais"
                                        @onclick="() => Estado.AdicionarTempo(30)">
                                    <Blazicon Svg="Lucide.Plus" /> 30s
                                </button>
                                <button class="btn btn-vazado menos"
                                        @onclick="() => Estado.SubtrairTempo(30)">
                                    <Blazicon Svg="Lucide.Minus" /> 30s
                                </button>
                                <button class="btn btn-vazado mais"
                                        @onclick="() => Estado.AdicionarTempo(15)">
                                    <Blazicon Svg="Lucide.Plus" /> 15s
                                </button>
                                <button class="btn btn-vazado menos"
                                        @onclick="() => Estado.SubtrairTempo(15)">
                                    <Blazicon Svg="Lucide.Minus" /> 15s
                                </button>
                                <button class="btn btn-vazado mais"
                                        @onclick="() => Estado.AdicionarTempo(5)">
                                    <Blazicon Svg="Lucide.Plus" /> 5s
                                </button>
                                <button class="btn btn-vazado menos"
                                        @onclick="() => Estado.SubtrairTempo(5)">
                                    <Blazicon Svg="Lucide.Minus" /> 5s
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else if (Estado.ModoAtual == ModoTelao.VotacaoNominal || Estado.ModoAtual == ModoTelao.ResultadoProclamado)
                {
                    <!-- MODO VOTAÇÃO & PROCLAMAÇÃO -->
                    <div style="background: #171717; border-radius: 12px; padding: 24px; border: 1px solid #292929; margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                            <div>
                                <span style="background: #0284c7; color: white; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: bold;">
                                    @(Estado.MateriaAtual?.Tipo ?? "Matéria") @(Estado.MateriaAtual?.Numero ?? "")
                                </span>
                                <h2 style="font-size: 1.3rem; margin-top: 6px; color: #f8fafc;">
                                    @(Estado.MateriaAtual?.Ementa ?? "Nenhuma matéria selecionada")
                                </h2>
                            </div>

                            @if (Estado.ModoAtual == ModoTelao.VotacaoNominal)
                            {
                                <button class="btn btn-verde" @onclick="() => Estado.VotacaoSimbolicaAprovarTodos()">
                                    Todos SIM
                                </button>
                            }
                        </div>

                        <!-- PLACAR AO VIVO -->
                        <div style="display: flex; gap: 16px; margin: 16px 0;">
                            <div class="placar-badge" style="color: #17B26A;">SIM: @Estado.TotalSim</div>
                            <div class="placar-badge" style="color: #ef4444;">NÃO: @Estado.TotalNao</div>
                            <div class="placar-badge" style="color: #f59e0b;">ABST.: @Estado.TotalAbstencao</div>
                            <div class="placar-badge" style="color: #94a3b8;">TOTAL: @Estado.TotalVotantes</div>
                        </div>

                        <!-- ÁREA DE PROCLAMAÇÃO PELO OPERADOR -->
                        <div style="border-top: 1px solid #292929; padding-top: 16px; margin-top: 16px; display: flex; justify-content: space-between; align-items: center;">
                            @if (Estado.ModoAtual == ModoTelao.VotacaoNominal)
                            {
                                <span style="color: #94a3b8; font-size: 0.95rem;">
                                    Aguarde a manifestação do Presidente e confirme a proclamação oficial:
                                </span>
                                <div style="display: flex; gap: 12px;">
                                    <button class="btn btn-verde" style="font-size: 1.05rem; padding: 10px 20px;"
                                            @onclick="() => Estado.ProclamarResultado(ResultadoVotacao.Aprovado)">
                                        <Blazicon Svg="Lucide.Check" /> Proclamar: APROVADO
                                    </button>
                                    <button class="btn btn-vermelho" style="font-size: 1.05rem; padding: 10px 20px;"
                                            @onclick="() => Estado.ProclamarResultado(ResultadoVotacao.Rejeitado)">
                                        <Blazicon Svg="Lucide.X" /> Proclamar: REJEITADO
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
                                    <div>
                                        <span style="color: #94a3b8; font-size: 0.9rem;">STATUS OFICIAL:</span>
                                        <strong style="margin-left: 8px; font-size: 1.2rem; color: @(Estado.ResultadoAtual == ResultadoVotacao.Aprovado ? "#17B26A" : "#ef4444")">
                                            MATÉRIA @Estado.ResultadoAtual?.ToString().ToUpper()
                                        </strong>
                                    </div>
                                    <button class="btn btn-amarelo" @onclick="() => Estado.ReabrirVotacao()">
                                        <Blazicon Svg="Lucide.RotateCcw" /> Reabrir Votação / Retificar
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            <!-- GRADE DOS VEREADORES (CHAMADA E REGISTRO DE VOTO) -->
            <h3 style="color: #cbd5e1; font-size: 1.1rem; margin-bottom: 12px;">
                @(Estado.ModoAtual == ModoTelao.VotacaoNominal ? "Votação Individual por Parlamentar" : "Registro de Presença (Clique para alternar)")
            </h3>

            <div class="grid-vereadores">
                @foreach (var vereador in Estado.ParlamentaresAtivos)
                {
                    var presenca = Estado.SessaoAtiva?.Presencas.FirstOrDefault(p => p.ParlamentarId == vereador.Id);
                    var presente = presenca?.Presente ?? false;
                    var voto = Estado.VotosMatériaAtual.TryGetValue(vereador.Id, out var v) ? v : TipoVoto.Ausente;
                    var fotoVereador = FotoHelper.ObterDataUrl(vereador.FotoCaminho);

                    <div class="card-vereador @(presente ? "presente" : "ausente")"
                         style="cursor: pointer;"
                         @onclick="() => { if (Estado.ModoAtual != ModoTelao.VotacaoNominal) Estado.AlternarPresenca(vereador.Id); }">
                        
                        @if (!string.IsNullOrEmpty(fotoVereador))
                        {
                            <img src="@fotoVereador" alt="@vereador.NomePolitico"
                                 style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid #292929;" />
                        }
                        else
                        {
                            <div style="font-size: 2.2rem; margin-bottom: 8px;"><Blazicon Svg="Lucide.User" /></div>
                        }
                        
                        <strong style="display: block; font-size: 1.1rem; color: #f8fafc;">@vereador.NomePolitico</strong>
                        <span style="font-size: 0.85rem; color: #94a3b8;">@vereador.Partido - @vereador.CargoMesa</span>

                        <div style="margin-top: 10px;">
                            @if (presente)
                            {
                                <span style="color: #17B26A; font-size: 0.85rem; font-weight: bold;">● Presente</span>
                            }
                            else
                            {
                                <span style="color: #64748b; font-size: 0.85rem;">○ Ausente</span>
                            }
                        </div>

                        <!-- SE ESTIVER EM MODO DE VOTAÇÃO, MOSTRA BOTÕES DE VOTO RÁPIDOS -->
                        @if (Estado.ModoAtual == ModoTelao.VotacaoNominal && presente)
                        {
                            <div style="display: flex; gap: 4px; margin-top: 12px;" @onclick:stopPropagation="true">
                                <button class="btn-micro @(voto == TipoVoto.Sim ? "ativo-sim" : "")"
                                        @onclick="() => Estado.RegistrarVoto(vereador.Id, TipoVoto.Sim)">
                                    SIM
                                </button>
                                <button class="btn-micro @(voto == TipoVoto.Nao ? "ativo-nao" : "")"
                                        @onclick="() => Estado.RegistrarVoto(vereador.Id, TipoVoto.Nao)">
                                    NÃO
                                </button>
                                <button class="btn-micro @(voto == TipoVoto.Abstencao ? "ativo-abs" : "")"
                                        @onclick="() => Estado.RegistrarVoto(vereador.Id, TipoVoto.Abstencao)">
                                    ABS
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </main>

    @if (confirmarExportacaoPdf)
    {
        <div class="modal-overlay" @onclick="() => confirmarExportacaoPdf = false">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-header-icon">
                    <Blazicon Svg="Lucide.FileDown" />
                </div>
                <h3 style="color: #FAFAFA; font-size: 1.15rem; font-weight: 700; margin-bottom: 8px;">
                    Exportar Extrato da Sessão
                </h3>
                <p style="color: #898989; font-size: 0.92rem; line-height: 1.5; margin-bottom: 22px;">
                    Deseja gerar o relatório oficial em PDF com as presenças e votações registradas até o momento?
                </p>
                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button class="btn" @onclick="() => confirmarExportacaoPdf = false">
                        Cancelar
                    </button>
                    <button class="btn btn-verde" @onclick="GerarExtratoPdf">
                        <Blazicon Svg="Lucide.Check" />
                        <span>Gerar</span>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
