<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="Assets\app.ico" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Sounds\*.wav">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Blazicons.Lucide" Version="3.2.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="QuestPDF" Version="2026.9.1" />
		<ProjectReference Include="..\PainelPlenario.Core\PainelPlenario.Core.csproj" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\PainelPlenario.Data\PainelPlenario.Data.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Assets\" />
	  <Folder Include="Sounds\" />
	</ItemGroup>

</Project>