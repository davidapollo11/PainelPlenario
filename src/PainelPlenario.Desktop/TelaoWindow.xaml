<Window x:Class="PainelPlenario.Desktop.TelaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:PainelPlenario.Desktop"
        Title="Telão de Plenário - Projeção Pública" 
        Height="720" Width="1280"
        WindowStartupLocation="Manual"
        Background="#0F0F0F">
    <Grid>
        <blazor:BlazorWebView HostPage="wwwroot/index.html" Services="{DynamicResource services}">
            <blazor:BlazorWebView.RootComponents>
                <!-- Repare que aqui ele carrega o TelaoView em vez do MainView -->
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:TelaoView}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>