@implements IDisposable
@inject PlenarioStateService Estado

<div class="telao-container" style="padding-bottom: 80px;">

    <!-- CABEÇALHO OFICIAL DO TELÃO -->
    <header class="telao-header">
        <div>
            <h1 class="telao-titulo">@Estado.Configuracao.NomeCamara.ToUpper()</h1>
            <p style="color: #898989; font-size: 1.2rem; font-weight: 500; margin-top: 4px;">
                @Estado.Configuracao.Slogan
            </p>
        </div>
        <div style="text-align: center;">
            <div class="placar-badge" style="font-size: 1.4rem; border-color: #15B79E;">
                QUÓRUM: <span style="color: #15B79E;">@Estado.TotalPresentes</span> / @Estado.Configuracao.TotalCadeiras
            </div>
            <span style="font-size: 0.95rem; color: #898989; display: block; margin-top: 4px;">
                @DateTime.Now.ToString("dd/MM/yyyy") | @Estado.Configuracao.Cidade-@Estado.Configuracao.Estado
            </span>
        </div>
    </header>

    <!-- CONTEÚDO PRINCIPAL (MUDA DINAMICAMENTE CONFORME O OPERADOR) -->
    <main style="flex: 1; display: flex; flex-direction: column; justify-content: center;">

        @if (Estado.ModoAtual == ModoTelao.QuorumPresenca)
        {
            <!-- CENA 1: LISTA DE PRESENÇA / QUÓRUM -->
            <div style="text-align: center; margin-bottom: 10px;">
                <h2 style="font-size: 1.8rem; color: #FAFAFA; text-transform: uppercase; letter-spacing: 2px;">
                    Verificação de Quórum
                </h2>
            </div>

            <div class="grid-vereadores">
                @foreach (var v in Estado.Parlamentares)
                {
                    var presenca = Estado.SessaoAtiva?.Presencas.FirstOrDefault(p => p.ParlamentarId == v.Id);
                    var presente = presenca?.Presente ?? false;

                    <div class="card-vereador @(presente ? "presente" : "ausente")" style="padding: 20px;">
                        <div style="display: flex; justify-content: center; margin-bottom: 10px;">
                            <Blazicon Svg="Lucide.User" style="@($"width: 44px; height: 44px; color: {(presente ? "#17B26A" : "#898989")};")" />
                        </div>
                        <h3 style="font-size: 1.3rem; color: #FAFAFA;">@v.NomePolitico</h3>
                        <p style="color: #898989; font-size: 1rem;">@v.Partido</p>
                        <div style="margin-top: 10px;">
                            @if (presente)
                            {
                                <span style="color: #17B26A; font-weight: bold; font-size: 1.1rem;">PRESENTE</span>
                            }
                            else
                            {
                                <span style="color: #898989; font-size: 1rem;">AUSENTE</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (Estado.ModoAtual == ModoTelao.TribunaCronometro)
        {
            <!-- CENA 2: CRONÔMETRO DE DISCURSO GIGANTE -->
            <div class="cronometro-box">
                <p style="color: #15B79E; font-size: 1.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 2px;">
                    Tempo de Tribuna
                </p>

                <div class="cronometro-tempo @(Estado.TempoRestanteSegundos <= 60 && Estado.TempoRestanteSegundos > 0 ? "cronometro-alerta" : "")"
                     style="font-size: 9rem; margin: 20px 0;">
                    @TimeSpan.FromSeconds(Estado.TempoRestanteSegundos).ToString(@"mm\:ss")
                </div>

                @if (Estado.TempoRestanteSegundos == 0 && !Estado.CronometroRodando)
                {
                    <div style="display: inline-flex; align-items: center; justify-content: center; gap: 12px; font-size: 2rem; color: #ef4444; font-weight: bold; text-transform: uppercase;">
                        <Blazicon Svg="Lucide.OctagonX" style="width: 34px; height: 34px;" />
                        <span>TEMPO ESGOTADO</span>
                    </div>
                }
            </div>
        }
        else if (Estado.ModoAtual == ModoTelao.VotacaoNominal)
        {
            <!-- CENA 3: VOTAÇÃO NOMINAL EM TEMPO REAL -->
            <div style="background: #171717; padding: 20px 30px; border-radius: 12px; border: 1px solid #292929; margin-bottom: 20px;">
                <span style="background: #15B79E; color: #0F0F0F; padding: 6px 14px; border-radius: 6px; font-weight: 800; font-size: 1.05rem;">
                    @(Estado.MateriaAtual?.Tipo ?? "Matéria") @(Estado.MateriaAtual?.Numero ?? "")
                </span>
                <h2 style="font-size: 1.6rem; color: #FAFAFA; margin-top: 12px; line-height: 1.4;">
                    @(Estado.MateriaAtual?.Ementa ?? "")
                </h2>
            </div>

            <!-- GRADE DE VOTOS AO VIVO -->
            <div class="grid-vereadores">
                @foreach (var v in Estado.Parlamentares)
                {
                    var presenca = Estado.SessaoAtiva?.Presencas.FirstOrDefault(p => p.ParlamentarId == v.Id);
                    var presente = presenca?.Presente ?? false;
                    var voto = Estado.VotosMatériaAtual.TryGetValue(v.Id, out var vt) ? vt : TipoVoto.Ausente;

                    string estiloVoto = "card-vereador";
                    string textoVoto = "AGUARDANDO";
                    string corTexto = "#898989";

                    if (!presente)
                    {
                        estiloVoto += " ausente";
                        textoVoto = "AUSENTE";
                    }
                    else if (voto == TipoVoto.Sim)
                    {
                        estiloVoto += " voto-sim";
                        textoVoto = "SIM";
                        corTexto = "#17B26A";
                    }
                    else if (voto == TipoVoto.Nao)
                    {
                        estiloVoto += " voto-nao";
                        textoVoto = "NÃO";
                        corTexto = "#ef4444";
                    }
                    else if (voto == TipoVoto.Abstencao)
                    {
                        estiloVoto += " voto-abstencao";
                        textoVoto = "ABSTENÇÃO";
                        corTexto = "#f59e0b";
                    }

                    <div class="@estiloVoto" style="padding: 16px;">
                        <h4 style="font-size: 1.2rem; color: #FAFAFA;">@v.NomePolitico</h4>
                        <span style="color: #898989; font-size: 0.9rem;">@v.Partido</span>
                        <div style="margin-top: 8px; font-size: 1.2rem; font-weight: 800; color: @corTexto;">
                            @textoVoto
                        </div>
                    </div>
                }
            </div>

            <!-- PLACAR GIGANTE NO RODAPÉ -->
            <footer style="display: flex; justify-content: center; gap: 30px; margin-top: 20px;">
                <div class="placar-badge" style="font-size: 1.8rem; color: #17B26A; border-color: #17B26A;">
                    SIM: @Estado.TotalSim
                </div>
                <div class="placar-badge" style="font-size: 1.8rem; color: #ef4444; border-color: #ef4444;">
                    NÃO: @Estado.TotalNao
                </div>
                <div class="placar-badge" style="font-size: 1.8rem; color: #f59e0b; border-color: #f59e0b;">
                    ABST.: @Estado.TotalAbstencao
                </div>
            </footer>
        }
        else if (Estado.ModoAtual == ModoTelao.ResultadoProclamado)
        {
            <!-- CENA 4: PROCLAMAÇÃO SOLENE DO RESULTADO -->
            var ehAprovado = Estado.ResultadoAtual == ResultadoVotacao.Aprovado;
            var ehUnanime = ehAprovado && Estado.TotalNao == 0 && Estado.TotalAbstencao == 0 && Estado.TotalSim > 0;

            <div style="background: #171717; padding: 20px 30px; border-radius: 12px; border: 1px solid #292929; margin-bottom: 30px;">
                <span style="background: #15B79E; color: #0F0F0F; padding: 6px 14px; border-radius: 6px; font-weight: 800; font-size: 1.05rem;">
                    @(Estado.MateriaAtual?.Tipo ?? "Matéria") @(Estado.MateriaAtual?.Numero ?? "")
                </span>
                <h2 style="font-size: 1.5rem; color: #FAFAFA; margin-top: 12px;">
                    @(Estado.MateriaAtual?.Ementa ?? "")
                </h2>
            </div>

            <!-- BANNER GIGANTE SOLENE -->
            <div style="text-align: center; padding: 40px; border-radius: 16px; margin: 20px 0;
                background: @(ehAprovado ? "linear-gradient(135deg, #064e3b, #059669)" : "linear-gradient(135deg, #7f1d1d, #b91c1c)");
                border: 3px solid @(ehAprovado ? "#17B26A" : "#ef4444");
                box-shadow: 0 0 60px @(ehAprovado ? "rgba(23, 178, 106, 0.35)" : "rgba(239, 68, 68, 0.35)");">

                <h1 style="display: inline-flex; align-items: center; justify-content: center; gap: 18px; font-size: 4rem; font-weight: 900; letter-spacing: 3px; color: #FAFAFA; text-transform: uppercase;">
                    @if (ehAprovado)
                    {
                        <Blazicon Svg="Lucide.Check" style="width: 56px; height: 56px;" />
                        <span>MATÉRIA APROVADA</span>
                    }
                    else
                    {
                        <Blazicon Svg="Lucide.X" style="width: 56px; height: 56px;" />
                        <span>MATÉRIA REJEITADA</span>
                    }
                </h1>

                <p style="font-size: 2rem; font-weight: 700; color: #FAFAFA; margin-top: 10px; opacity: 0.95;">
                    @if (ehUnanime)
                    {
                        <span>(POR UNANIMIDADE DOS VOTOS)</span>
                    }
                    else if (ehAprovado)
                    {
                        <span>(POR MAIORIA DOS VOTOS)</span>
                    }
                    else
                    {
                        <span>(NÃO ALCANÇOU A MAIORIA REGIMENTAL)</span>
                    }
                </p>
            </div>

            <!-- PLACAR OFICIAL CONGELADO -->
            <footer style="display: flex; justify-content: center; gap: 30px; margin-top: 30px;">
                <div class="placar-badge" style="font-size: 2rem; color: #17B26A; border-color: #17B26A;">
                    SIM: @Estado.TotalSim
                </div>
                <div class="placar-badge" style="font-size: 2rem; color: #ef4444; border-color: #ef4444;">
                    NÃO: @Estado.TotalNao
                </div>
                <div class="placar-badge" style="font-size: 2rem; color: #f59e0b; border-color: #f59e0b;">
                    ABST.: @Estado.TotalAbstencao
                </div>
            </footer>
        }
    </main>

    <!-- RODAPÉ ESTILO NEWS TICKER (JORNAL TELEVISIVO) -->
    <div class="ticker-bar">
        <div class="ticker-badge">
            <div class="ponto-gravacao"></div>
            AO VIVO
        </div>

        <div class="ticker-content">
            @{
                var textoNoticias = string.Join("   |   ", noticias.Any() ? noticias : new[] { "Conectando à Agência Brasil..." });
            }
            <div class="ticker-track">
                <!-- Bloco 1 -->
                <span class="ticker-item">@textoNoticias | </span>
                <!-- Bloco 2 (cópia espelhada contínua) -->
                <span class="ticker-item">@textoNoticias | </span>
            </div>
        </div>

        <div class="ticker-clock">
            @horarioAtual
        </div>
    </div>
</div>

@code {
    private string horarioAtual = DateTime.Now.ToString("HH:mm:ss");
    private List<string> noticias = new();
    private System.Timers.Timer? _relogioTimer;

    protected override async Task OnInitializedAsync()
    {
        // Conecta ao motor de estado do plenário
        Estado.OnMudancaEstado += AtualizarTelao;

        // 1. Busca as notícias da Agência Brasil de forma assíncrona
        noticias = await NoticiasService.ObterNoticiasAsync();

        // 2. Inicia o relógio oficial que atualiza segundo a segundo
        _relogioTimer = new System.Timers.Timer(1000);
        _relogioTimer.Elapsed += (s, e) =>
        {
            horarioAtual = DateTime.Now.ToString("HH:mm:ss");
            InvokeAsync(StateHasChanged);
        };
        _relogioTimer.Start();
    }

    private void AtualizarTelao()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Estado.OnMudancaEstado -= AtualizarTelao;

        if (_relogioTimer != null)
        {
            _relogioTimer.Stop();
            _relogioTimer.Dispose();
            _relogioTimer = null;
        }
    }
}