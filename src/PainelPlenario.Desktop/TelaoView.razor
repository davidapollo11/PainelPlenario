@using System.IO
@implements IDisposable
@inject PlenarioStateService Estado

<div class="telao-container" style="padding-bottom: 80px;">

    <!-- CABEÇALHO OFICIAL DO TELÃO -->
    <header class="telao-header">
        <div>
            <h1 class="telao-titulo">@Estado.Configuracao.NomeCamara.ToUpper()</h1>
            <p style="color: #898989; font-size: 1.2rem; font-weight: 500; margin-top: 4px;">
                @Estado.Configuracao.Slogan
            </p>
        </div>
        <div style="text-align: center;">
            <div class="placar-badge" style="font-size: 1.4rem; border-color: #15B79E;">
                QUÓRUM: <span style="color: #15B79E;">@Estado.TotalPresentes</span> / @Estado.Configuracao.TotalCadeiras
            </div>
            <span style="font-size: 0.95rem; color: #898989; display: block; margin-top: 4px;">
                @DateTime.Now.ToString("dd/MM/yyyy") | @Estado.Configuracao.Cidade-@Estado.Configuracao.Estado
            </span>
        </div>
    </header>

    <!-- CONTEÚDO PRINCIPAL (MUDA DINAMICAMENTE CONFORME O OPERADOR) -->
    <main style="flex: 1; display: flex; flex-direction: column; justify-content: center;">

        @if (Estado.ModoAtual == ModoTelao.QuorumPresenca)
        {
            @* <!-- CENA 1: LISTA DE PRESENÇA / QUÓRUM -->
            <div style="text-align: center; margin-bottom: 10px;">
                <h2 style="font-size: 1.8rem; color: #FAFAFA; text-transform: uppercase; letter-spacing: 2px;">
                    Verificação de Quórum
                </h2>
            </div> *@

            <div class="grid-vereadores">
                @foreach (var v in Estado.ParlamentaresAtivos)
                {
                    var presenca = Estado.SessaoAtiva?.Presencas.FirstOrDefault(p => p.ParlamentarId == v.Id);
                    var presente = presenca?.Presente ?? false;

                    <div class="card-vereador @(presente ? "presente" : "ausente")" style="padding: 20px;">
                        @{
                            var fotoSrc = FotoHelper.ObterDataUrl(v.FotoCaminho);
                        }
                        <div style="display: flex; justify-content: center; margin-bottom: 12px;">
                            @if (!string.IsNullOrEmpty(fotoSrc))
                            {
                                <img src="@fotoSrc" alt="@v.NomePolitico"
                                     style="@($"width: 84px; height: 84px; border-radius: 50%; object-fit: cover; border: 2px solid {(presente ? "#17B26A" : "#3C3C3C")};")" />
                            }
                            else
                            {
                                <div style="@($"width: 84px; height: 84px; border-radius: 50%; background: #0F0F0F; border: 2px solid {(presente ? "#17B26A" : "#3C3C3C")}; display: flex; align-items: center; justify-content: center;")">
                                    <Blazicon Svg="Lucide.User" style="@($"width: 40px; height: 40px; color: {(presente ? "#17B26A" : "#898989")};")" />
                                </div>
                            }
                        </div>
                        <h3 style="font-size: 1.3rem; color: #FAFAFA;">@v.NomePolitico</h3>
                        <p style="color: #898989; font-size: 1rem;">@v.Partido</p>
                        <div style="margin-top: 10px;">
                            @if (presente)
                            {
                                <span style="color: #17B26A; font-weight: bold; font-size: 1.1rem;">PRESENTE</span>
                            }
                            else
                            {
                                <span style="color: #898989; font-size: 1rem;">AUSENTE</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (Estado.ModoAtual == ModoTelao.TribunaCronometro)
        {
            @if (Estado.OradorAtual != null)
            {
                <!-- ESTADO COM PARLAMENTAR NA PALAVRA (SEM CARD, FOTO GRANDE) -->
                var fotoOrador = FotoHelper.ObterDataUrl(Estado.OradorAtual.FotoCaminho);

                <div style="display: flex; align-items: center; justify-content: center; gap: 80px; flex-wrap: wrap; margin: 40px auto; width: 100%; max-width: 1500px;">

                    <!-- BLOCO DO ORADOR -->
                    <div style="display: flex; flex-direction: column; align-items: center;">

                        <!-- FOTO GRANDE -->
                        @if (!string.IsNullOrEmpty(fotoOrador))
                        {
                            <div style="width: 21vw; border-radius: 15%; overflow: hidden; background: #171717; border: 4px solid #15B79E; box-shadow: 0 12px 40px rgba(0, 0, 0, 0.7), 0 0 30px rgba(21, 183, 158, 0.25); display: flex; align-items: center; justify-content: center;">
                                <img src="@fotoOrador" alt="@Estado.OradorAtual.NomePolitico" style="width: 100%; height: 100%; object-fit: cover;" />
                            </div>
                        }

                        <!-- IDENTIFICAÇÃO DO ORADOR (ALINHADA À ESQUERDA) -->
                        <div style="display: flex; flex-direction: column; align-items: flex-start; margin-top: 22px; gap: 8px">
                            <!-- NOME POLÍTICO + PARTIDO NA MESMA LINHA -->
                            <div style="font-size: 1.35rem; color: #898989; font-weight: 600; margin-top: 6px; text-transform: uppercase; letter-spacing: 1.5px;">
                                <span style="color: #15B79E; font-size: 1.3rem; font-weight: 800;">
                                    Com a palavra:
                                </span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 16px;">
                                <h2 style="font-size: 2.8rem; font-weight: 800; color: #FAFAFA; line-height: 1.1; margin: 0; letter-spacing: 0.5px;">
                                    @Estado.OradorAtual.NomePolitico
                                </h2>
                                <span style="background: #171717; border: 1.5px solid #15B79E; color: #15B79E; font-size: 1.3rem; font-weight: 800; padding: 4px 14px; border-radius: 8px;">
                                    @Estado.OradorAtual.Partido
                                </span>
                            </div>

                            <!-- CARGO NA MESA ALINHADO À ESQUERDA DO NOME -->
                            <div style="font-size: 1.35rem; color: #898989; font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px;">
                                @Estado.OradorAtual.CargoMesa
                            </div>
                        </div>
                    </div>

                    <!-- CRONÔMETRO GIGANTE HARMONIZADO -->
                    <div style="text-align: center;">
                        <p style="color: #898989; font-size: 1.3rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2.5px; margin-bottom: 8px;">
                            Tempo de Tribuna
                        </p>

                        <div class="cronometro-tempo @(Estado.TempoRestanteSegundos <= 60 && Estado.TempoRestanteSegundos > 0 ? "cronometro-alerta" : "")"
                             style="font-size: 10rem; line-height: 1; font-weight: 900;">
                            @TimeSpan.FromSeconds(Estado.TempoRestanteSegundos).ToString(@"mm\:ss")
                        </div>

                        @if (Estado.TempoRestanteSegundos == 0 && !Estado.CronometroRodando)
                        {
                            <div style="display: inline-flex; align-items: center; justify-content: center; gap: 12px; font-size: 2rem; color: #ef4444; font-weight: bold; text-transform: uppercase; margin-top: 16px;">
                                <Blazicon Svg="Lucide.OctagonX" style="width: 36px; height: 36px;" />
                                <span>TEMPO ESGOTADO</span>
                            </div>
                        }

                        <!-- CARD DE APARTE ABAIXO DO CRONÔMETRO -->
                        @if (Estado.ApartanteAtual != null)
                        {
                            var fotoApartante = FotoHelper.ObterDataUrl(Estado.ApartanteAtual.FotoCaminho);

                            <div style="margin-top: 24px; display: inline-flex; align-items: center; gap: 16px; background: rgba(245, 158, 11, 0.1); border: 2px solid #f59e0b; padding: 12px 22px; border-radius: 12px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);">
                                <!-- FOTO DO APARTANTE -->
                                    @if (!string.IsNullOrEmpty(fotoApartante))
                                    {
                                        <div style="width: 58px; height: 58px; border-radius: 50%; overflow: hidden; background: #171717; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                <img src="@fotoApartante" alt="@Estado.ApartanteAtual.NomePolitico" style="width: 100%; height: 100%; object-fit: cover;" />
                                        </div>
                                    }

                                <!-- TEXTO DO APARTE -->
                                <div style="text-align: left;">
                                    <span style="display: block; font-size: 0.82rem; font-weight: 800; color: #f59e0b; text-transform: uppercase; letter-spacing: 1.5px;">
                                        Em Aparte:
                                    </span>
                                    <div style="display: flex; align-items: center; gap: 8px; margin-top: 2px;">
                                        <strong style="color: #FAFAFA; font-size: 1.4rem; font-weight: 800;">
                                            @Estado.ApartanteAtual.NomePolitico
                                        </strong>
                                        <span style="background: #292929; color: #f59e0b; font-size: 0.95rem; font-weight: 700; padding: 2px 8px; border-radius: 4px;">
                                            @Estado.ApartanteAtual.Partido
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- ESTADO PADRÃO / NEUTRO (SEM PARLAMENTAR VINCULADO) -->
                <div class="cronometro-box">
                    <p style="color: #15B79E; font-size: 1.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 2px;">
                        Tempo de Tribuna
                    </p>

                    <div class="cronometro-tempo @(Estado.TempoRestanteSegundos <= 60 && Estado.TempoRestanteSegundos > 0 ? "cronometro-alerta" : "")"
                         style="font-size: 9rem; margin: 20px 0;">
                        @TimeSpan.FromSeconds(Estado.TempoRestanteSegundos).ToString(@"mm\:ss")
                    </div>

                    @if (Estado.TempoRestanteSegundos == 0 && !Estado.CronometroRodando)
                    {
                        <div style="display: inline-flex; align-items: center; justify-content: center; gap: 12px; font-size: 2rem; color: #ef4444; font-weight: bold; text-transform: uppercase;">
                            <Blazicon Svg="Lucide.OctagonX" style="width: 34px; height: 34px;" />
                            <span>TEMPO ESGOTADO</span>
                        </div>
                    }
                </div>
            }
        }
        else if (Estado.ModoAtual == ModoTelao.VotacaoNominal)
        {
            <!-- CENA 3: VOTAÇÃO NOMINAL EM TEMPO REAL -->
            <div style="background: #171717; padding: 20px 30px; border-radius: 12px; border: 1px solid #292929; margin-bottom: 20px;">
                <span style="background: #15B79E; color: #0F0F0F; padding: 6px 14px; border-radius: 6px; font-weight: 800; font-size: 1.05rem;">
                    @(Estado.MateriaAtual?.Tipo ?? "Matéria") @(Estado.MateriaAtual?.Numero ?? "")
                </span>
                <h2 style="font-size: 1.6rem; color: #FAFAFA; margin-top: 12px; line-height: 1.4;">
                    @(Estado.MateriaAtual?.Ementa ?? "")
                </h2>
            </div>

            <!-- GRADE DE VOTOS AO VIVO -->
            <div class="grid-vereadores">
                @foreach (var v in Estado.ParlamentaresAtivos)
                {
                    var presenca = Estado.SessaoAtiva?.Presencas.FirstOrDefault(p => p.ParlamentarId == v.Id);
                    var presente = presenca?.Presente ?? false;
                    var voto = Estado.VotosMatériaAtual.TryGetValue(v.Id, out var vt) ? vt : TipoVoto.Ausente;

                    string estiloVoto = "card-vereador";
                    string textoVoto = "AGUARDANDO";
                    string corTexto = "#898989";

                    if (!presente)
                    {
                        estiloVoto += " ausente";
                        textoVoto = "AUSENTE";
                    }
                    else if (voto == TipoVoto.Sim)
                    {
                        estiloVoto += " voto-sim";
                        textoVoto = "SIM";
                        corTexto = "#17B26A";
                    }
                    else if (voto == TipoVoto.Nao)
                    {
                        estiloVoto += " voto-nao";
                        textoVoto = "NÃO";
                        corTexto = "#ef4444";
                    }
                    else if (voto == TipoVoto.Abstencao)
                    {
                        estiloVoto += " voto-abstencao";
                        textoVoto = "ABSTENÇÃO";
                        corTexto = "#f59e0b";
                    }

                    <div class="@estiloVoto" style="padding: 16px;">
                        @{
                            var fotoVoto = FotoHelper.ObterDataUrl(v.FotoCaminho);
                        }
                        <div style="display: flex; justify-content: center; margin-bottom: 8px;">
                            @if (!string.IsNullOrEmpty(fotoVoto))
                            {
                                <img src="@fotoVoto" alt="@v.NomePolitico"
                                     style="width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid #292929;" />
                            }
                            else
                            {
                                <div style="width: 60px; height: 60px; border-radius: 50%; background: #0F0F0F; border: 2px solid #292929; display: flex; align-items: center; justify-content: center;">
                                    <Blazicon Svg="Lucide.User" style="width: 28px; height: 28px; color: #898989;" />
                                </div>
                            }
                        </div>
                        <h4 style="font-size: 1.2rem; color: #FAFAFA;">@v.NomePolitico</h4>
                        <span style="color: #898989; font-size: 0.9rem;">@v.Partido</span>
                        <div style="margin-top: 8px; font-size: 1.2rem; font-weight: 800; color: @corTexto;">
                            @textoVoto
                        </div>
                    </div>
                }
            </div>

            <!-- PLACAR GIGANTE NO RODAPÉ -->
            <footer style="display: flex; justify-content: center; gap: 30px; margin-top: 20px;">
                <div class="placar-badge" style="font-size: 1.8rem; color: #17B26A; border-color: #17B26A;">
                    SIM: @Estado.TotalSim
                </div>
                <div class="placar-badge" style="font-size: 1.8rem; color: #ef4444; border-color: #ef4444;">
                    NÃO: @Estado.TotalNao
                </div>
                <div class="placar-badge" style="font-size: 1.8rem; color: #f59e0b; border-color: #f59e0b;">
                    ABST.: @Estado.TotalAbstencao
                </div>
            </footer>
        }
        else if (Estado.ModoAtual == ModoTelao.ResultadoProclamado)
        {
            <!-- CENA 4: PROCLAMAÇÃO SOLENE DO RESULTADO -->
            var ehAprovado = Estado.ResultadoAtual == ResultadoVotacao.Aprovado;
            var ehUnanime = ehAprovado && Estado.TotalNao == 0 && Estado.TotalAbstencao == 0 && Estado.TotalSim > 0;

            <div style="background: #171717; padding: 20px 30px; border-radius: 12px; border: 1px solid #292929; margin-bottom: 30px;">
                <span style="background: #15B79E; color: #0F0F0F; padding: 6px 14px; border-radius: 6px; font-weight: 800; font-size: 1.05rem;">
                    @(Estado.MateriaAtual?.Tipo ?? "Matéria") @(Estado.MateriaAtual?.Numero ?? "")
                </span>
                <h2 style="font-size: 1.5rem; color: #FAFAFA; margin-top: 12px;">
                    @(Estado.MateriaAtual?.Ementa ?? "")
                </h2>
            </div>

            <!-- BANNER GIGANTE SOLENE -->
            <div style="text-align: center; padding: 40px; border-radius: 16px; margin: 20px 0;
                background: @(ehAprovado ? "linear-gradient(135deg, #064e3b, #059669)" : "linear-gradient(135deg, #7f1d1d, #b91c1c)");
                border: 3px solid @(ehAprovado ? "#17B26A" : "#ef4444");
                box-shadow: 0 0 60px @(ehAprovado ? "rgba(23, 178, 106, 0.35)" : "rgba(239, 68, 68, 0.35)");">

                <h1 style="display: inline-flex; align-items: center; justify-content: center; gap: 18px; font-size: 4rem; font-weight: 900; letter-spacing: 3px; color: #FAFAFA; text-transform: uppercase;">
                    @if (ehAprovado)
                    {
                        <Blazicon Svg="Lucide.Check" style="width: 56px; height: 56px;" />
                        <span>MATÉRIA APROVADA</span>
                    }
                    else
                    {
                        <Blazicon Svg="Lucide.X" style="width: 56px; height: 56px;" />
                        <span>MATÉRIA REJEITADA</span>
                    }
                </h1>

                <p style="font-size: 2rem; font-weight: 700; color: #FAFAFA; margin-top: 10px; opacity: 0.95;">
                    @if (ehUnanime)
                    {
                        <span>(POR UNANIMIDADE DOS VOTOS)</span>
                    }
                    else if (ehAprovado)
                    {
                        <span>(POR MAIORIA DOS VOTOS)</span>
                    }
                    else
                    {
                        <span>(NÃO ALCANÇOU A MAIORIA REGIMENTAL)</span>
                    }
                </p>
            </div>

            <!-- PLACAR OFICIAL CONGELADO -->
            <footer style="display: flex; justify-content: center; gap: 30px; margin-top: 30px;">
                <div class="placar-badge" style="font-size: 2rem; color: #17B26A; border-color: #17B26A;">
                    SIM: @Estado.TotalSim
                </div>
                <div class="placar-badge" style="font-size: 2rem; color: #ef4444; border-color: #ef4444;">
                    NÃO: @Estado.TotalNao
                </div>
                <div class="placar-badge" style="font-size: 2rem; color: #f59e0b; border-color: #f59e0b;">
                    ABST.: @Estado.TotalAbstencao
                </div>
            </footer>
        }
    </main>

    <!-- RODAPÉ ESTILO NEWS TICKER (JORNAL TELEVISIVO) -->
    <div class="ticker-bar">
        <div class="ticker-badge">
            <div class="ponto-gravacao"></div>
            AO VIVO
        </div>

        <div class="ticker-content">
            @{
                var textoNoticias = string.Join("   |   ", noticias.Any() ? noticias : new[] { "Conectando à Agência Brasil..." });
            }
            <div class="ticker-track">
                <!-- Bloco 1 -->
                <span class="ticker-item">@textoNoticias | </span>
                <!-- Bloco 2 (cópia espelhada contínua) -->
                <span class="ticker-item">@textoNoticias | </span>
            </div>
        </div>

        <div class="ticker-clock">
            @horarioAtual
        </div>
    </div>
</div>

@code {
    private string horarioAtual = DateTime.Now.ToString("HH:mm:ss");
    private List<string> noticias = new();
    private System.Timers.Timer? _relogioTimer;
    private int _ultimoTempoObservado;
    private System.Windows.Media.MediaPlayer? _audioPlayer;
    protected override async Task OnInitializedAsync()
    {
        // Guarda o tempo inicial para não tocar som ao apenas abrir o Telão zerado
        _ultimoTempoObservado = Estado.TempoRestanteSegundos;
        // Conecta ao motor de estado do plenário
        Estado.OnMudancaEstado += AtualizarTelao;
        // 1. Busca as notícias da Agência Brasil de forma assíncrona
        noticias = await NoticiasService.ObterNoticiasAsync();
        // 2. Inicia o relógio oficial que atualiza segundo a segundo
        _relogioTimer = new System.Timers.Timer(1000);
        _relogioTimer.Elapsed += (s, e) =>
        {
            horarioAtual = DateTime.Now.ToString("HH:mm:ss");
            InvokeAsync(StateHasChanged);
        };
        _relogioTimer.Start();
    }
    private void AtualizarTelao()
    {
        InvokeAsync(() =>
        {
            VerificarAlertaSonoro();
            StateHasChanged();
        });
    }
    private void VerificarAlertaSonoro()
    {
        var tempoAtual = Estado.TempoRestanteSegundos;
        // Só dispara se o Telão estiver exibindo a Tribuna
        if (Estado.ModoAtual == ModoTelao.TribunaCronometro)
        {
            // Transição exata de 31s -> 30s (não repete se pausar/retomar em 30s)
            if (_ultimoTempoObservado > 30 && tempoAtual == 30 && Estado.CronometroRodando)
            {
                TocarSom("alerta_30s.wav");
            }
            // Transição exata de 1s -> 0s (não dispara se clicar em zerar antes da hora)
            else if (_ultimoTempoObservado == 1 && tempoAtual == 0)
            {
                TocarSom("tempo_esgotado.wav");
            }
        }
        _ultimoTempoObservado = tempoAtual;
    }
    private void TocarSom(string nomeArquivo)
    {
        var caminho = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Sounds", nomeArquivo);
        if (!File.Exists(caminho)) return;
        System.Windows.Application.Current?.Dispatcher.InvokeAsync(() =>
        {
            _audioPlayer?.Close();
            _audioPlayer = new System.Windows.Media.MediaPlayer();
            _audioPlayer.Open(new Uri(caminho, UriKind.Absolute));
            _audioPlayer.Play();
        });
    }
    public void Dispose()
    {
        Estado.OnMudancaEstado -= AtualizarTelao;
        if (_relogioTimer != null)
        {
            _relogioTimer.Stop();
            _relogioTimer.Dispose();
            _relogioTimer = null;
        }
        System.Windows.Application.Current?.Dispatcher.InvokeAsync(() =>
        {
            _audioPlayer?.Close();
            _audioPlayer = null;
        });
    }
}